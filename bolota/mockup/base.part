<!doctype html><html lang="pt-BR"><head><meta charset="utf-8">
<title>BOLOTA — estudos de direção de arte</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700;800&display=swap">
<style>
  html,body{margin:0;height:100%;background:#0d1412;overflow:hidden}
  canvas{display:block;width:100vw;height:100vh}
  #nome{position:fixed;left:22px;bottom:18px;z-index:9;color:#fff;
    font:800 15px 'Baloo 2',system-ui;letter-spacing:.14em;text-transform:uppercase;
    background:rgba(10,16,14,.55);padding:8px 16px;border-radius:99px;
    border:1px solid rgba(255,255,255,.18);backdrop-filter:blur(6px)}
</style></head><body>
<canvas id="c"></canvas><div id="nome"></div>
<script>
// ===========================================================================
// Estudos de direção de arte para a BOLOTA.
// Mesma cena, mesma composição, mesma pose — três tratamentos diferentes.
// ===========================================================================

const cv = document.getElementById('c');
const g = cv.getContext('2d');
const DPR = Math.min(devicePixelRatio || 1, 2);
let W = 1400, H = 820;
function tamanho() {
  W = innerWidth; H = innerHeight;
  cv.width = Math.round(W * DPR); cv.height = Math.round(H * DPR);
  g.setTransform(DPR, 0, 0, DPR, 0, 0);
}

// --- ruído ------------------------------------------------------------------
const PERM = new Uint8Array(512);
(function () {
  let s = 20260903; const p = new Uint8Array(256);
  for (let i = 0; i < 256; i++) p[i] = i;
  for (let i = 255; i > 0; i--) { s = (s * 1103515245 + 12345) & 0x7fffffff;
    const j = s % (i + 1); const t = p[i]; p[i] = p[j]; p[j] = t; }
  for (let i = 0; i < 512; i++) PERM[i] = p[i & 255];
})();
const fade = t => t*t*t*(t*(t*6-15)+10);
function grad(h,x,y){ switch(h&3){case 0:return x+y;case 1:return -x+y;case 2:return x-y;default:return -x-y;} }
function ruido(x,y){
  const xi=Math.floor(x)&255, yi=Math.floor(y)&255;
  const xf=x-Math.floor(x), yf=y-Math.floor(y);
  const u=fade(xf), v=fade(yf);
  const aa=PERM[PERM[xi]+yi], ab=PERM[PERM[xi]+yi+1];
  const ba=PERM[PERM[xi+1]+yi], bb=PERM[PERM[xi+1]+yi+1];
  const x1=lerp(grad(aa,xf,yf),grad(ba,xf-1,yf),u);
  const x2=lerp(grad(ab,xf,yf-1),grad(bb,xf-1,yf-1),u);
  return lerp(x1,x2,v)*0.5;
}
function fbm(x,y,o=4){ let v=0,a=.5,f=1; for(let i=0;i<o;i++){ v+=ruido(x*f,y*f)*a; f*=2; a*=.5; } return v; }
const lerp=(a,b,t)=>a+(b-a)*t;
const clamp=(v,a,b)=>v<a?a:v>b?b:v;
const TAU=Math.PI*2;
let semente=1;
function rnd(){ semente=(semente*1664525+1013904223)&0x7fffffff; return semente/0x7fffffff; }
function faixa(a,b){ return a+rnd()*(b-a); }

function rgbDe(c){
  if (Array.isArray(c)) return c;
  if (c[0]==='#'){ const n=parseInt(c.slice(1,7),16); return [(n>>16)&255,(n>>8)&255,n&255]; }
  const m=c.match(/-?[\d.]+/g); return m?[+m[0],+m[1],+m[2]]:[0,0,0];
}
function mix(a,b,t){ const A=rgbDe(a),B=rgbDe(b);
  return `rgb(${Math.round(lerp(A[0],B[0],t))},${Math.round(lerp(A[1],B[1],t))},${Math.round(lerp(A[2],B[2],t))})`; }
function alfa(c,a){ const [r,gg,b]=rgbDe(c); return `rgba(${r},${gg},${b},${a})`; }
function clarear(c,t){ return mix(c,'#ffffff',t); }
function escurecer(c,t){ return mix(c,'#101418',t); }

// --- geometria da cena (a mesma nos três estudos) ---------------------------
//
// A composição importa mais que a técnica: a versão anterior deixava 60% da
// tela ocupada por uma massa de terra chapada e vazia. Aqui o chão de jogo é
// uma faixa estreita, o fundo tem quatro planos de profundidade, e os cantos
// são fechados por folhagem — que é como praticamente todo plataforma 2D bem
// resolvido enquadra a cena.
function cena() {
  const horizonte = H*0.50;
  const colinaFim = W*0.455, penhascoIni = W*0.575;
  const colinaTopo = (x) => {
    const t = clamp((x+80)/(colinaFim+80),0,1);
    return H*0.715 - Math.sin(t*Math.PI*0.92)*H*0.085 + fbm(x*0.005,3.1,2)*9;
  };
  const penhascoTopo = (x) => H*0.615 - fbm(x*0.004,17,2)*13;
  return {
    horizonte, colinaTopo, penhascoTopo, colinaFim, penhascoIni,
    agua: H*0.945,
    sol: {x: W*0.78, y: H*0.20, r: Math.min(W,H)*0.048},
    bolota: {x: W*0.30, escala: Math.min(W,H)/620*2.05},
    // quatro planos de fundo, do mais longe ao mais perto
    planos: [
      {base: horizonte-6,  r: 34, n: 16, sem: 1, nevoa: 0.72},
      {base: horizonte+34, r: 50, n: 12, sem: 5, nevoa: 0.50},
      {base: horizonte+86, r: 64, n: 9,  sem: 9, nevoa: 0.28},
      {base: horizonte+142,r: 46, n: 14, sem: 13, nevoa: 0.10},
    ],
  };
}

/** Adereços em cima do chão: é o que tira a sensação de superfície vazia. */
function adereços(S){
  semente = 4242;
  const lista = [];
  const emCima = (x0,x1,topo,n) => {
    for(let i=0;i<n;i++){
      const x = faixa(x0,x1);
      lista.push({x, y: topo(x)+1, tipo: escolher(), esc: faixa(0.75,1.35)});
    }
  };
  const tipos = ['cogumelo','samambaia','pedra','flor','flor','tufo','tufo','tufo','cogumelo'];
  let k=0; const escolher = () => tipos[(k++*5+3) % tipos.length];
  emCima(-40, S.colinaFim-20, S.colinaTopo, 16);
  emCima(S.penhascoIni+20, W+30, S.penhascoTopo, 12);
  lista.push({x: W*0.40, y: S.colinaTopo(W*0.40)+1, tipo:'tronco', esc:1.15});
  lista.sort((a,b)=>a.x-b.x);
  return lista;
}

// --- pose fixa do personagem ------------------------------------------------
function ik2(ax,ay,bx,by,l1,l2,lado){
  let dx=bx-ax, dy=by-ay, d=Math.hypot(dx,dy);
  const mn=Math.abs(l1-l2)+0.01, mx=l1+l2-0.01;
  if(d<mn){const k=mn/(d||1e-6);dx*=k;dy*=k;d=mn;}
  if(d>mx){const k=mx/d;dx*=k;dy*=k;d=mx;}
  const base=Math.atan2(dy,dx);
  const a=Math.acos(clamp((l1*l1+d*d-l2*l2)/(2*l1*d),-1,1))*lado;
  return {x:ax+Math.cos(base+a)*l1, y:ay+Math.sin(base+a)*l1, fx:ax+dx, fy:ay+dy};
}
function pose(){
  // em unidades de personagem: pés em y=0, para cima é negativo
  const q={x:0.6,y:-17}, pe={x:0,y:-33}, cab={x:-0.4,y:-55};
  const ombro=[{x:pe.x-9.5,y:pe.y-3},{x:pe.x+9.5,y:pe.y-3}];
  const anca=[{x:q.x-5.5,y:q.y},{x:q.x+5.5,y:q.y}];
  const mao=[{x:-14.5,y:-19},{x:15.5,y:-20.5}];
  const pes=[{x:-7.5,y:0.5},{x:7.2,y:0}];
  const cot=[ik2(ombro[0].x,ombro[0].y,mao[0].x,mao[0].y,9.5,8.5,-1),
             ik2(ombro[1].x,ombro[1].y,mao[1].x,mao[1].y,9.5,8.5,1)];
  const joe=[ik2(anca[0].x,anca[0].y,pes[0].x,pes[0].y,10,9,1),
             ik2(anca[1].x,anca[1].y,pes[1].x,pes[1].y,10,9,1)];
  return {q,pe,cab,ombro,anca,mao,pes,cot,joe,cabR:16};
}
window.__pose = pose;

